{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TruthfulnessGuard",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[A-F][0-9]{2}$"
    },
    "result": {
      "type": "string",
      "enum": [
        "UNKNOWN_OR_REVIEW",
        "AWAITING_USER",
        "SUPPORTED"
      ]
    },
    "can_autofill": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "safe_next_action": {
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "result",
    "can_autofill",
    "reason",
    "missing_information",
    "safe_next_action"
  ],
  "additionalProperties": false
}
