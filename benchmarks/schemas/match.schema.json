{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MatchAssessment",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[A-F][0-9]{2}$"
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "decision": {
      "type": "string",
      "enum": [
        "APPLY",
        "REVIEW",
        "REJECT"
      ]
    },
    "factual_matches": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_projects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "explanation": {
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "score",
    "decision",
    "factual_matches",
    "gaps",
    "blockers",
    "missing_information",
    "recommended_projects",
    "explanation"
  ],
  "additionalProperties": false
}
