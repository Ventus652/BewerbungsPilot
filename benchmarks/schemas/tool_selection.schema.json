{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolSelection",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[A-F][0-9]{2}$"
    },
    "tool": {
      "type": "string",
      "enum": [
        "read_official_offer",
        "save_offer",
        "ask_user"
      ]
    },
    "arguments": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "question": {
          "type": "string"
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "tool",
    "arguments",
    "reason"
  ],
  "additionalProperties": false
}
